<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setu • Caretaker Sanctuary Access</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body class="auth-sanctuary-body">

    <!-- Ambient Organic Background Blobs -->
    <div class="organic-ambient-bg" aria-hidden="true">
        <div class="organic-blob blob-1"></div>
        <div class="organic-blob blob-2"></div>
        <div class="organic-blob blob-3"></div>
    </div>

    <div class="auth-sanctuary-container">
        
        <div class="sanctuary-stone-card" id="parent-auth-card">
            
            <div class="sanctuary-header">
                <a href="/" class="auth-brand-badge" title="Setu Garden Home">
                    <div class="brand-crest mini">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="4" ry="4"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <span>Caretaker Gate</span>
                </a>
                <h1>Caretaker PIN Access</h1>
                <p>Enter the 4-digit security PIN set for your child's browser to unlock the sanctuary dashboard.</p>
            </div>

            <% if (error) { %>
                <div class="auth-error-pebble" id="auth-error-message">
                    <span>⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof rememberedUser !== 'undefined' && rememberedUser) { %>
                <div class="user-chip-context" style="background: rgba(84, 122, 93, 0.08); border-radius: 14px; padding: 0.75rem 1.1rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; border: 1px solid rgba(84, 122, 93, 0.15);">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <img src="<%= rememberedUser.avatar || 'https://api.dicebear.com/7.x/bottts/svg?seed=Setu' %>" alt="<%= rememberedUser.name %>" style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1.5px solid #fff;">
                        <div style="text-align: left;">
                            <div style="font-weight: 600; font-size: 0.92rem; color: #203124;"><%= rememberedUser.name %></div>
                            <div style="font-size: 0.76rem; color: #58675b;"><%= rememberedUser.email %></div>
                        </div>
                    </div>
                    <a href="/login" style="font-size: 0.8rem; color: #2f5439; font-weight: 600; text-decoration: none; padding: 0.35rem 0.7rem; background: rgba(255,255,255,0.7); border-radius: 999px;">Switch</a>
                </div>
            <% } %>

            <!-- Quick Google/Email Account Switch Option -->
            <div class="quick-auth-methods">
                <a href="/login" class="quick-pill-btn google-pill" id="login-google-link">
                    <svg width="16" height="16" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Sign In with Google or Password</span>
                </a>
            </div>

            <form method="POST" action="/parent-login" class="auth-form" id="pin-login-form">
                <% if (typeof rememberedUser !== 'undefined' && rememberedUser) { %>
                    <input type="hidden" name="email" value="<%= rememberedUser.email %>">
                <% } else { %>
                    <div class="pin-stone-field-group" style="margin-bottom: 1.1rem; text-align: left;">
                        <label for="email" class="pin-stone-label" style="font-size: 0.85rem; margin-bottom: 0.35rem; display: block; text-transform: none; letter-spacing: normal;">Caretaker Account Email</label>
                        <input type="email" id="email" name="email" value="<%= (typeof rememberedEmail !== 'undefined') ? (rememberedEmail || '') : '' %>" placeholder="e.g. sarah@example.com" required class="pin-stone-input" style="font-family: inherit; font-size: 0.95rem; letter-spacing: normal; padding: 0.75rem 1rem;">
                    </div>
                <% } %>

                <div class="pin-stone-field-group">
                    <label for="pin" class="pin-stone-label">4-Digit Security PIN</label>
                    <input type="password" id="pin" name="pin" maxlength="6" pattern="[0-9]{4,6}" inputmode="numeric" placeholder="••••" required autofocus class="pin-stone-input" autocomplete="off">
                </div>

                <!-- Tactile River-Stone Keypad -->
                <div class="sanctuary-keypad-grid" aria-label="PIN Keypad">
                    <% [1, 2, 3, 4, 5, 6, 7, 8, 9, 0].forEach(function(num) { %>
                        <button type="button" class="keypad-pebble" onclick="appendPin('<%= num %>')"><%= num %></button>
                    <% }); %>
                    <button type="button" class="keypad-pebble clear-btn" onclick="clearPin()" title="Clear PIN">C</button>
                </div>

                <button type="submit" class="sanctuary-unlock-btn" id="unlock-sanctuary-button">
                    <span>Unlock Sanctuary</span>
                    <span>→</span>
                </button>
            </form>

            <div class="sanctuary-tip-pebble">
                <p>🛡️ <strong>Individual Family PIN:</strong> Each account sets their own secret PIN for their child. No default PIN exists. Forgotten your PIN? Sign in with your Google or email password to view or change it.</p>
            </div>

            <div class="sanctuary-back-link">
                <a href="/register" id="create-account-link">✨ Create New Caretaker Account</a> • 
                <a href="/" id="return-browser-link">Return to Safe Garden</a>
            </div>

        </div>

    </div>

    <script>
        function appendPin(val) {
            const field = document.getElementById('pin');
            if (field.value.length < 10) {
                field.value += val;
            }
        }
        function clearPin() {
            document.getElementById('pin').value = '';
        }
    </script>
</body>
</html>
