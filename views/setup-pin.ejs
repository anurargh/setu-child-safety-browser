<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setu • Create Security PIN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body class="auth-sanctuary-body">

    <!-- Ambient Organic Background Blobs -->
    <div class="organic-ambient-bg" aria-hidden="true">
        <div class="organic-blob blob-1"></div>
        <div class="organic-blob blob-2"></div>
        <div class="organic-blob blob-3"></div>
    </div>

    <div class="auth-sanctuary-container">
        
        <div class="sanctuary-stone-card" id="setup-pin-card">
            
            <div class="sanctuary-header">
                <div class="auth-brand-badge" title="Setu Safe Internet">
                    <div class="brand-crest mini">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="4" ry="4"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <span>Caretaker Gate</span>
                </div>
                <h1>Create Security PIN</h1>
                <p>Set a 4 to 6 digit PIN to protect your parent dashboard from child access.</p>
            </div>

            <% if (error) { %>
                <div class="auth-error-pebble" id="auth-error-message">
                    <span>⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof info !== 'undefined' && info) { %>
                <div class="auth-info-pebble" style="background: rgba(84, 122, 93, 0.12); border: 1px solid rgba(84, 122, 93, 0.25); color: #203124; padding: 0.65rem 1rem; border-radius: 12px; margin-bottom: 1.25rem; font-size: 0.88rem; display: flex; align-items: center; gap: 0.5rem;">
                    <span>🌿</span>
                    <span><%= info %></span>
                </div>
            <% } %>

            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-chip-context" style="background: rgba(84, 122, 93, 0.08); border-radius: 14px; padding: 0.75rem 1.1rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; border: 1px solid rgba(84, 122, 93, 0.15);">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/bottts/svg?seed=Setu' %>" alt="<%= user.name %>" style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1.5px solid #fff;">
                        <div style="text-align: left;">
                            <div style="font-weight: 600; font-size: 0.92rem; color: #203124;"><%= user.name %></div>
                            <div style="font-size: 0.76rem; color: #58675b;"><%= user.email %></div>
                        </div>
                    </div>
                    <span style="font-size: 0.78rem; color: #3b6245; font-weight: 600; background: rgba(255,255,255,0.85); padding: 0.3rem 0.65rem; border-radius: 999px;">Caretaker</span>
                </div>
            <% } %>

            <form method="POST" action="/setup-pin" class="auth-form" id="setup-pin-form">
                <div class="pin-stone-field-group">
                    <label for="pin" class="pin-stone-label">Security PIN (4–6 digits)</label>
                    <input type="password" id="pin" name="pin" maxlength="6" minlength="4" pattern="[0-9]{4,6}" inputmode="numeric" placeholder="••••" required autofocus class="pin-stone-input" autocomplete="off">
                </div>

                <div class="pin-stone-field-group" style="margin-top: 1rem;">
                    <label for="confirmPin" class="pin-stone-label">Confirm Security PIN</label>
                    <input type="password" id="confirmPin" name="confirmPin" maxlength="6" minlength="4" pattern="[0-9]{4,6}" inputmode="numeric" placeholder="••••" required class="pin-stone-input" autocomplete="off">
                </div>

                <!-- Tactile River-Stone Keypad -->
                <div class="sanctuary-keypad-grid" aria-label="PIN Keypad" style="margin-top: 1.25rem;">
                    <% [1, 2, 3, 4, 5, 6, 7, 8, 9, 0].forEach(function(num) { %>
                        <button type="button" class="keypad-pebble" onclick="appendPin('<%= num %>')"><%= num %></button>
                    <% }); %>
                    <button type="button" class="keypad-pebble clear-btn" onclick="clearPin()" title="Clear PIN">C</button>
                </div>

                <button type="submit" class="sanctuary-unlock-btn" id="save-pin-button" style="margin-top: 1.5rem;">
                    <span>Save PIN & Open Dashboard</span>
                    <span>→</span>
                </button>
            </form>

            <div class="sanctuary-back-link" style="margin-top: 1.25rem;">
                <a href="/" id="return-search-link">Return to Safe Search</a>
            </div>

        </div>

    </div>

    <script>
        let activeField = 'pin';

        document.getElementById('pin').addEventListener('focus', function() {
            activeField = 'pin';
        });

        document.getElementById('confirmPin').addEventListener('focus', function() {
            activeField = 'confirmPin';
        });

        function appendPin(val) {
            const field = document.getElementById(activeField);
            if (field && field.value.length < 6) {
                field.value += val;
                if (field.value.length >= 4 && activeField === 'pin') {
                    const confirmField = document.getElementById('confirmPin');
                    if (confirmField && !confirmField.value) {
                        confirmField.focus();
                        activeField = 'confirmPin';
                    }
                }
            }
        }

        function clearPin() {
            const field = document.getElementById(activeField);
            if (field) {
                field.value = '';
            }
        }
    </script>
</body>
</html>
