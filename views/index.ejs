                { label: "🪐 Planets & Stars", query: "Planets stars and moon for young kids", cat: "visual" },
                { label: "🐬 Ocean Animals", query: "Dolphins whales and sea turtles facts", cat: "educational" },
                { label: "💻 Coding Games", query: "Fun coding games for kids", cat: "educational" },
                { label: "🎧 Bedtime Stories", query: "Quiet bedtime story audio and nature sounds", cat: "media" },
                { label: "🎨 Zoo Baby Animals", query: "San Diego Zoo baby animals webcams", cat: "visual" }
            ]
        };

        function getAgeTier(age) {
            const a = parseInt(age, 10) || 8;
            if (a >= 14) return 'teens';
            if (a >= 11) return 'middle';
            if (a >= 8) return 'upper_elem';
            return 'early';
        }

        let activeTier = getAgeTier("<%= formAge || 8 %>");
        let SPOTLIGHT_DATA = SPOTLIGHT_BY_TIER[activeTier] || SPOTLIGHT_BY_TIER.upper_elem;

        function updateCuriositiesForTier(tier) {
            const wrap = document.getElementById('quick-curiosities-wrap');
            const promptEl = document.getElementById('curiosity-prompt-label');
            if (promptEl) {
                promptEl.textContent = tier === 'teens' ? 'Research Topics:' : tier === 'middle' ? 'Inquiry Topics:' : 'Gentle Topics:';
            }
            if (!wrap || !CURIOSITIES_BY_TIER[tier]) return;
            wrap.innerHTML = CURIOSITIES_BY_TIER[tier].map(item => `
                <a href="javascript:void(0)" onclick="quickSearch('${item.query.replace(/'/g, "\\'")}')" class="curiosity-pebble" data-tab-category="${item.cat}">
                    ${item.label}
                </a>
            `).join('');
        }

        function handleAgeChange(newAge) {
            const parsed = parseInt(newAge, 10) || 8;
            const clamped = Math.min(17, Math.max(5, parsed));
            activeTier = getAgeTier(clamped);
            SPOTLIGHT_DATA = SPOTLIGHT_BY_TIER[activeTier] || SPOTLIGHT_BY_TIER.upper_elem;
            
            // 1. Update quick topic pebbles to match new maturity
            updateCuriositiesForTier(activeTier);
            
            // 2. Update inquiry age tag if on results page
            const ageTag = document.querySelector('.inquiry-age-tag');
            if (ageTag) {
                ageTag.textContent = `Evaluated for Age ${clamped}`;
            }

            // 3. Re-render spotlight cards on the current tab
            const currentTab = document.getElementById('tab-input')?.value || 'all';
            selectGardenTab(currentTab);
        }

        function selectGardenTab(tabName, isUserClick = false) {
            // 1. Update tab button active states
            const tabButtons = document.querySelectorAll('.garden-tab');
            tabButtons.forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.getElementById('tab-btn-' + tabName);
            if (activeBtn) {
                activeBtn.classList.add('active');
            }

            // 2. Update simulated address bar path (clean, never includes Age)
            const pathEl = document.getElementById('address-bar-path');
            const queryField = document.getElementById('query');
            const queryVal = queryField ? queryField.value.trim() : '';
            if (pathEl) {
                let p = '/explore';
                const params = [];
                if (queryVal) params.push('q=' + encodeURIComponent(queryVal));
                if (tabName !== 'all') params.push('tab=' + encodeURIComponent(tabName));
                if (params.length > 0) p += '?' + params.join('&');
                pathEl.textContent = p;
            }

            // 3. Update hidden input in search form
            const tabInput = document.getElementById('tab-input');
            if (tabInput) {
                tabInput.value = tabName;
            }

            // If user typed a search query on the discovery home and clicked a category tab, search it directly!
            const initialCards = document.querySelectorAll('#results-deck .discovery-card');
            if (isUserClick && initialCards.length === 0 && queryVal.length > 0) {
                const searchForm = document.getElementById('child-search-form');
                if (searchForm) {
                    searchForm.submit();
                    return;
                }
            }

            // 4. Update browser URL history (no age in path)
            try {
                let browserUrl = '/';
                const urlParams = [];
                if (queryVal) urlParams.push('q=' + encodeURIComponent(queryVal));
                if (tabName !== 'all') urlParams.push('tab=' + encodeURIComponent(tabName));
                if (urlParams.length > 0) browserUrl = '/explore?' + urlParams.join('&');
                window.history.replaceState({ tab: tabName, q: queryVal }, '', browserUrl);
            } catch (_) {}

            // 5. Handle empty / welcome state spotlight
            const spotlightContainer = document.getElementById('category-welcome-spotlight');
            if (spotlightContainer) {
                spotlightContainer.style.display = 'block';
                renderSpotlightCards(tabName);
            }

            // 6. Filter search results if present
            const cards = document.querySelectorAll('.discovery-card[data-tab-category]');
            const fallbackDeck = document.getElementById('results-fallback-deck');
            const fallbackCards = document.getElementById('results-fallback-cards');
            const fallbackHeader = document.getElementById('results-fallback-header');

            let visibleCount = 0;
            if (cards.length > 0) {
                cards.forEach(card => {
                    const cardCat = card.getAttribute('data-tab-category');
                    if (tabName === 'all' || cardCat === tabName) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // If specific category has 0 results from AI, render curated fallback items
                if (visibleCount === 0 && fallbackDeck && fallbackCards && SPOTLIGHT_DATA[tabName]) {
                    fallbackDeck.style.display = 'block';
                    let catTitle = (activeTier === 'teens') ? 'Academic Portals' : 'Educational Portals';
                    if (tabName === 'visual') catTitle = (activeTier === 'teens') ? 'Observatories & 3D Simulations' : 'Visual & 3D Interactive Guides';
                    if (tabName === 'media') catTitle = (activeTier === 'teens') ? 'Lectures, Deep-Dives & Podcasts' : 'Safe Quiet Media & Audio Stories';
                    if (fallbackHeader) {
                        fallbackHeader.textContent = `🌿 Verified Safe ${catTitle} for "${queryVal || 'Discovery'}"`;
                    }
                    fallbackCards.innerHTML = SPOTLIGHT_DATA[tabName].map((item, idx) => `
                        <article class="discovery-card" id="fallback-card-${idx}" data-tab-category="${tabName}">
                            <div class="card-top-row">
                                <span class="domain-leaf">🌐 ${item.domain}</span>
                                <span class="category-pebble">${item.category}</span>
                                <span class="safety-check-chip">✓ ${item.badge}</span>
                            </div>
                            <h2 class="card-headline">
                                <a href="${item.url}" target="_blank" rel="noopener">${item.title}</a>
                            </h2>
                            <p class="card-body-text">${item.snippet}</p>
                            <div class="card-action-row">
                                <a href="${item.url}" target="_blank" rel="noopener" class="safe-visit-btn">
                                    <span>Open Safe Page</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        </article>
                    `).join('');
                } else if (fallbackDeck) {
                    fallbackDeck.style.display = 'none';
                }

                // 7. Update tally counter
                const tallyEl = document.getElementById('results-tally-count');
                if (tallyEl) {
                    let catLabel = 'verified safe learning destinations';
                    if (tabName === 'educational') catLabel = (activeTier === 'teens') ? 'verified secondary & academic research portals' : 'verified educational learning sites';
                    if (tabName === 'visual') catLabel = (activeTier === 'teens') ? 'verified observatories, 3D anatomy & STEM simulations' : 'verified visual & 3D exploration guides';
                    if (tabName === 'media') catLabel = (activeTier === 'teens') ? 'verified academic lectures, documentaries & podcasts' : 'verified safe quiet media & audio destinations';
                    const displayCount = visibleCount > 0 ? visibleCount : (SPOTLIGHT_DATA[tabName] ? SPOTLIGHT_DATA[tabName].length : 0);
                    tallyEl.textContent = `Found ${displayCount} ${catLabel}${queryVal ? ` for "${queryVal}"` : ''}`;
                }
            }

            // 8. Filter curiosity pebbles on home page
            const pebbles = document.querySelectorAll('.curiosity-pebble');
            pebbles.forEach(peb => {
                const pebCat = peb.getAttribute('data-tab-category');
                if (tabName === 'all' || !pebCat || pebCat === tabName) {
                    peb.style.display = '';
                } else {
                    peb.style.display = 'none';
                }
            });
        }

        function renderSpotlightCards(tabName) {
            const container = document.getElementById('spotlight-cards-deck');
            const header = document.getElementById('spotlight-header');
            if (!container || !SPOTLIGHT_DATA[tabName]) return;
            
            let title = '🌿 All Verified Safe Discoveries';
            if (activeTier === 'teens') {
                if (tabName === 'all') title = '🌿 Verified Secondary & Academic Research Collections';
                if (tabName === 'educational') title = '📚 Verified Academic Reference & High School Portals';
                if (tabName === 'visual') title = '🎨 Observatories, 3D Anatomy & University STEM Models';
                if (tabName === 'media') title = '🎧 Curated Academic Lectures, CrashCourse & Documentaries';
            } else if (activeTier === 'middle') {
                if (tabName === 'all') title = '🌿 Verified Middle School Discovery Destinations';
                if (tabName === 'educational') title = '📚 Verified Middle School Reference & Student Science Hubs';
                if (tabName === 'visual') title = '🎨 Interactive Science Exhibits & High-Res Space Imagery';
                if (tabName === 'media') title = '🎧 Student Video Lessons, Documentaries & Critical Debates';
            } else if (activeTier === 'upper_elem') {
                if (tabName === 'all') title = '🌿 Verified Safe Upper Elementary Discoveries';
                if (tabName === 'educational') title = '📚 Verified Elementary Encyclopedias & Nature Portals';
                if (tabName === 'visual') title = '🎨 3D Animal Cutaways & Interactive Lab Explorations';
                if (tabName === 'media') title = '🎧 Curious Science Podcasts & Thoughtful Debates';
            } else {
                if (tabName === 'all') title = '🌿 Verified Gentle Discoveries for Young Explorers';
                if (tabName === 'educational') title = '📚 Gentle Early Learning Portals & Story Guides';
                if (tabName === 'visual') title = '🎨 Colorful Wildlife Safaris & Big 3D Pictures';
                if (tabName === 'media') title = '🎧 Peaceful Audio Stories & Ad-Free Learning Shows';
            }
            if (header) header.textContent = title;

            container.innerHTML = SPOTLIGHT_DATA[tabName].map((item, idx) => `
                <article class="discovery-card" id="spotlight-card-${idx}">
                    <div class="card-top-row">
                        <span class="domain-leaf">🌐 ${item.domain}</span>
                        <span class="category-pebble">${item.category}</span>
                        <span class="safety-check-chip">✓ ${item.badge}</span>
                    </div>
                    <h2 class="card-headline">
                        <a href="${item.url}" target="_blank" rel="noopener">${item.title}</a>
                    </h2>
                    <p class="card-body-text">${item.snippet}</p>
                    <div class="card-action-row">
                        <a href="${item.url}" target="_blank" rel="noopener" class="safe-visit-btn">
                            <span>Open Safe Page</span>
                            <span>↗</span>
                        </a>
                    </div>
                </article>
            `).join('');
        }

        // Initialize active tab on load
        document.addEventListener('DOMContentLoaded', function() {
            const currentTab = "<%= (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'all' %>";
            selectGardenTab(currentTab || 'all');
        });
    </script>
</body>
</html>
