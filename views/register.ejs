<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setu • Register Caretaker Account</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body class="auth-sanctuary-body">

    <!-- Ambient Organic Background Blobs -->
    <div class="organic-ambient-bg" aria-hidden="true">
        <div class="organic-blob blob-1"></div>
        <div class="organic-blob blob-2"></div>
        <div class="organic-blob blob-3"></div>
    </div>

    <div class="auth-sanctuary-container">
        
        <div class="sanctuary-stone-card auth-wide-card" id="register-card">
            
            <div class="sanctuary-header">
                <a href="/" class="auth-brand-badge" title="Setu Garden Home">
                    <div class="brand-crest mini">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z"/>
                            <path d="M12 8C12 8 10 10.5 10 12.5C10 13.88 10.9 15 12 15C13.1 15 14 13.88 14 12.5C14 10.5 12 8 12 8Z"/>
                        </svg>
                    </div>
                    <span>Setu Safe Browser</span>
                </a>
                <h1>Create Caretaker Account</h1>
                <p>Register once via Google or your email. Your account and child oversight settings will stay permanently saved.</p>
            </div>

            <!-- Error and Info Toasts -->
            <% if (error) { %>
                <div class="auth-error-pebble" id="auth-error-message">
                    <span>⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (info) { %>
                <div class="auth-info-pebble" id="auth-info-message">
                    <span>🌿</span>
                    <span><%= info %></span>
                </div>
            <% } %>

            <!-- Primary 1-Click Action: Google Account Registration -->
            <div class="social-auth-section">
                <button type="button" class="google-auth-btn" id="google-signup-btn" onclick="openGoogleAuthPopup()">
                    <svg class="google-icon" width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Sign up with Google</span>
                </button>
                <p class="social-subtext">Instant, single-click sign up. Automatically links to your Google account.</p>
            </div>

            <!-- Natural Divider -->
            <div class="auth-divider-stone">
                <span class="divider-line"></span>
                <span class="divider-text">or register normally with email</span>
                <span class="divider-line"></span>
            </div>

            <!-- Email & Password Form -->
            <form method="POST" action="/register" class="auth-form" id="register-form">
                <div class="auth-input-group">
                    <label for="name" class="auth-label">Full Name / Caretaker Name</label>
                    <input type="text" id="name" name="name" placeholder="e.g., Sarah Parker" value="<%= formName || '' %>" required class="auth-input-stone">
                </div>

                <div class="auth-input-group">
                    <label for="email" class="auth-label">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="sarah@example.com" value="<%= formEmail || '' %>" required class="auth-input-stone" autocomplete="email">
                </div>

                <div class="auth-input-row">
                    <div class="auth-input-group">
                        <label for="password" class="auth-label">Create Password (6+ chars)</label>
                        <input type="password" id="password" name="password" minlength="6" placeholder="••••••••" required class="auth-input-stone" autocomplete="new-password">
                    </div>
                    <div class="auth-input-group">
                        <label for="confirmPassword" class="auth-label">Confirm Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" placeholder="••••••••" required class="auth-input-stone" autocomplete="new-password">
                    </div>
                </div>

                <div class="auth-input-group">
                    <label for="parentPin" class="auth-label">Security PIN (4–6 digits)</label>
                    <input type="password" id="parentPin" name="parentPin" pattern="[0-9]{4,6}" inputmode="numeric" maxlength="6" minlength="4" placeholder="••••" required class="auth-input-stone" autocomplete="off">
                </div>

                <button type="submit" class="sanctuary-unlock-btn" id="create-account-button">
                    <span>Create Account</span>
                    <span>→</span>
                </button>
            </form>

            <div class="auth-switch-deck">
                <p>Already have an account? <a href="/login" class="auth-switch-link">Sign In</a></p>
                <p><a href="/parent-login" class="auth-switch-link">Parent PIN Access</a> • <a href="/" class="auth-switch-link">Return to Search</a></p>
            </div>

            <!-- Firebase Status Indicator -->
            <div style="margin-top: 1.5rem; text-align: center; font-size: 0.78rem; color: #7B887E;">
                <span>🔥 Powered by Google Firebase Auth & Cloud Firestore</span>
            </div>

        </div>

    </div>

    <!-- Firebase SDK & Google Authentication -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.0/firebase-app.js";
        import { getAuth, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/10.14.0/firebase-auth.js";

        let fbAuth = null;
        let fbProvider = null;

        try {
            const config = <%- JSON.stringify(firebaseConfig || {}) %>;
            if (config && config.apiKey) {
                const app = initializeApp(config);
                fbAuth = getAuth(app);
                fbProvider = new GoogleAuthProvider();
                fbProvider.setCustomParameters({ prompt: 'select_account' });
            }
        } catch (err) {
            console.warn("Client Firebase init note:", err);
        }

        window.openGoogleAuthPopup = async function() {
            const btn = document.getElementById('google-signup-btn');
            const originalText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.innerHTML = 'Connecting to Google Firebase...';
            }

            // 1. Try Firebase Auth with Google Popup directly
            if (fbAuth && fbProvider) {
                try {
                    const result = await signInWithPopup(fbAuth, fbProvider);
                    if (result && result.user) {
                        const u = result.user;
                        const res = await fetch('/api/auth/firebase-login', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                uid: u.uid,
                                email: u.email,
                                displayName: u.displayName || u.email.split('@')[0],
                                photoURL: u.photoURL,
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            window.location.href = data.redirectUrl || '/dashboard';
                            return;
                        } else {
                            alert(data.error || 'Registration failed.');
                        }
                    }
                } catch (fbErr) {
                    console.warn("Firebase popup sign-in fallback:", fbErr);
                }
            }

            // 2. Fallback to server-side OAuth popup
            const width = 560;
            const height = 660;
            const left = Math.max(0, (window.innerWidth - width) / 2 + window.screenX);
            const top = Math.max(0, (window.innerHeight - height) / 2 + window.screenY);

            const authWindow = window.open(
                '/auth/google/login',
                'setu_google_oauth',
                `width=${width},height=${height},top=${top},left=${left},scrollbars=yes,status=no,resizable=yes`
            );

            if (!authWindow) {
                alert('Please allow popups for Setu to authenticate with your Google account.');
            }
            if (btn) btn.innerHTML = originalText;
        };

        // Listen for postMessage from OAuth popup fallback
        window.addEventListener('message', function(event) {
            const origin = event.origin || '';
            if (!origin.endsWith('.run.app') && !origin.includes('localhost') && !origin.includes('0.0.0.0')) {
                return;
            }

            if (event.data && event.data.type === 'OAUTH_AUTH_SUCCESS') {
                window.location.href = '/dashboard?welcome=google';
            } else if (event.data && event.data.type === 'OAUTH_AUTH_ERROR') {
                alert('Authentication notice: ' + (event.data.error || 'Unknown error'));
            }
        });
    </script>
</body>
</html>
