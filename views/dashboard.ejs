<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setu • Caretaker Dashboard & Safety Garden</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,400;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/style.css">
</head>
<body class="dashboard-sanctuary-body">

    <!-- Ambient Organic Background Blobs -->
    <div class="organic-ambient-bg" aria-hidden="true">
        <div class="organic-blob blob-1"></div>
        <div class="organic-blob blob-2"></div>
        <div class="organic-blob blob-3"></div>
    </div>

    <!-- Caretaker Top Navigation -->
    <header class="dash-navbar">
        <div class="nav-brand">
            <a href="/dashboard" class="brand-link" id="dash-home-link">
                <div class="brand-crest">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z"/>
                        <path d="M12 8C12 8 10 10.5 10 12.5C10 13.88 10.9 15 12 15C13.1 15 14 13.88 14 12.5C14 10.5 12 8 12 8Z"/>
                    </svg>
                </div>
                <div class="brand-text-group">
                    <span class="brand-name">Setu Caretaker</span>
                    <span class="brand-subtitle">Garden Oversight & Insights</span>
                </div>
            </a>
            <% if (user) { %>
                <div class="dash-user-pill">
                    <img src="<%= user.avatar %>" alt="<%= user.name %>" class="dash-avatar-thumb" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=Setu';">
                    <span><%= user.name %></span>
                    <span class="account-verified-check">✓</span>
                </div>
            <% } else { %>
                <span class="tended-badge">
                    <span class="dew-drop-pulse"></span>
                    <span>Sanctuary Session Active</span>
                </span>
            <% } %>
        </div>

        <div class="tended-nav-actions">
            <a href="/" class="dash-open-child-btn" id="open-child-garden-btn">
                <span>🌱 Open Child Garden</span>
            </a>
            <form method="POST" action="/logout" style="display:inline;">
                <button type="submit" class="dash-lock-logout-btn" id="dash-logout-btn">
                    <span>🔒 Logout & Secure</span>
                </button>
            </form>
        </div>
    </header>

    <main class="dash-tended-container">

        <!-- Notification Toast -->
        <% if (pinUpdatedMessage) { %>
            <div class="tended-toast <%= pinUpdatedMessage.includes('Error') ? 'toast-error' : 'toast-success' %>" id="action-notification-toast">
                <span><%= pinUpdatedMessage.includes('Error') ? '⚠️' : '🌿' %></span>
                <span><%= pinUpdatedMessage %></span>
            </div>
        <% } %>

        <!-- Caretaker Reassuring Overview Deck -->
        <section class="dash-hero-deck">
            <div class="hero-lead-text">
                <h1>The Caretaker's Garden Sanctuary</h1>
                <p>Gentle, transparent oversight into your child's curiosities, search rationale, and peer-reviewed safety citations.</p>
            </div>
            
            <div class="garden-health-monitor monitor-<%= alertLevel %>" id="security-monitor-status">
                <div class="monitor-icon">
                    <%= alertLevel === 'clean' ? '🌿' : (alertLevel === 'warning' ? '🌾' : '🛡️') %>
                </div>
                <div>
                    <h3 class="monitor-title">Garden Balance Status</h3>
                    <p class="monitor-desc"><%= securityAlert %></p>
                </div>
            </div>
        </section>

        <!-- Caretaker Account Profile & Unification Banner -->
        <section class="caretaker-account-card" id="caretaker-profile-section">
            <div class="account-card-left">
                <% if (user) { %>
                    <img src="<%= user.avatar %>" alt="<%= user.name %>" class="account-large-avatar" onerror="this.src='https://api.dicebear.com/7.x/bottts/svg?seed=Setu';">
                    <div class="account-info-block">
                        <div class="account-name-row">
                            <h2><%= user.name %></h2>
                            <span class="auth-provider-chip <%= user.authProvider %>">
                                <% if (user.authProvider === 'both') { %>
                                    🌿 Unified (Google + Password)
                                <% } else if (user.authProvider === 'google') { %>
                                    🌐 Google Account
                                <% } else { %>
                                    ✉️ Email & Password
                                <% } %>
                            </span>
                        </div>
                        <p class="account-email-line">
                            <strong>Registered Email:</strong> <%= user.email %> • 
                            <strong>Member since:</strong> <%= user.createdAt.substring(0, 10) %>
                        </p>
                        <div class="account-persistence-note">
                            <span class="persistence-icon">🔒</span>
                            <span><strong>Account Saved & Persistent:</strong> You never have to create another account. You can log in anytime with your Google account or email credentials across sessions.</span>
                        </div>
                    </div>
                <% } else { %>
                    <div class="account-info-block">
                        <h2>Guest Caretaker Session (PIN Unlocked)</h2>
                        <p class="account-email-line">You are currently accessing via temporary 4-digit PIN unlock. Register once to sync your settings and keep your dashboard permanently saved.</p>
                        <div style="margin-top: 0.75rem;">
                            <a href="/register" class="register-now-cta">✨ Create Permanent Account</a>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="account-card-right">
                <div class="status-summary-box">
                    <div class="summary-line">
                        <span>Database:</span>
                        <strong class="status-active">Firebase Firestore</strong>
                    </div>
                    <div class="summary-line">
                        <span>Authentication:</span>
                        <strong><%= user && user.authProvider === 'google' ? 'Google Account' : (user && user.authProvider === 'both' ? 'Google & Password' : 'Email & Password') %></strong>
                    </div>
                    <div class="summary-line">
                        <span>Security PIN:</span>
                        <% if (user && user.parentPin) { %>
                            <strong class="status-active">Configured ✓</strong>
                        <% } else { %>
                            <strong style="color: #c94a29; font-weight: 700;">Not Configured</strong>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>

        <% if (user && !user.parentPin) { %>
            <div class="sanctuary-notice-pebble" style="background: rgba(84, 122, 93, 0.08); border: 1px solid rgba(84, 122, 93, 0.2); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.25rem;">🔒</span>
                    <div>
                        <strong style="color: #243d2c; font-size: 0.95rem;">Security PIN Required</strong>
                        <span style="color: #58675b; font-size: 0.85rem; display: block;">Configure a PIN to protect parental settings.</span>
                    </div>
                </div>
                <a href="#pin-management-card" style="padding: 0.5rem 1rem; background: #2f5439; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.84rem;">
                    Configure PIN →
                </a>
            </div>
        <% } %>

        <!-- Metric River-Stones Grid -->
        <section class="tended-metrics-grid" aria-label="Activity Metrics">
            <div class="metric-river-stone total" id="metric-total-card">
                <div class="metric-count"><%= totalCount %></div>
                <div class="metric-label-text">Total Inquiries Logged</div>
                <span class="metric-sub-note">100% Real-Time AI Review</span>
            </div>

            <div class="metric-river-stone allowed" id="metric-allowed-card">
                <div class="metric-count"><%= allowedCount %></div>
                <div class="metric-label-text">Flourishing & Allowed</div>
                <span class="metric-sub-note">Safe educational websites provided</span>
            </div>

            <div class="metric-river-stone risky" id="metric-risky-card">
                <div class="metric-count"><%= riskyCount %></div>
                <div class="metric-label-text">Guidance Recommended</div>
                <span class="metric-sub-note">Research grounding cited</span>
            </div>

            <div class="metric-river-stone blocked" id="metric-blocked-card">
                <div class="metric-count"><%= blockedCount %></div>
                <div class="metric-label-text">Harmful Content Shielded</div>
                <span class="metric-sub-note">Protected before exposure</span>
            </div>
        </section>

        <!-- Tended Activity Logs & Filter Section -->
        <section class="tended-activity-section" id="activity-logs-section">
            
            <div class="activity-header-bar">
                <h2>Exploration Activity Log</h2>
                
                <div class="activity-controls-cluster">
                    <div class="filter-stone-group" aria-label="Filter Inquiries">
                        <a href="/dashboard?filter=all" class="filter-stone-pill <%= currentFilter === 'all' ? 'active' : '' %>">All (<%= totalCount %>)</a>
                        <a href="/dashboard?filter=allowed" class="filter-stone-pill <%= currentFilter === 'allowed' ? 'active' : '' %>">Safe (<%= allowedCount %>)</a>
                        <a href="/dashboard?filter=risky" class="filter-stone-pill <%= currentFilter === 'risky' ? 'active' : '' %>">Guidance (<%= riskyCount %>)</a>
                        <a href="/dashboard?filter=blocked" class="filter-stone-pill <%= currentFilter === 'blocked' ? 'active' : '' %>">Shielded (<%= blockedCount %>)</a>
                    </div>

                    <div class="export-pebble-actions">
                        <a href="/parent-export?format=csv" class="export-pebble-btn" id="export-csv-btn">📥 CSV</a>
                        <a href="/parent-export?format=json" class="export-pebble-btn" id="export-json-btn">📥 JSON</a>
                    </div>
                </div>
            </div>

            <!-- Table of Logged Queries -->
            <% if (queries && queries.length > 0) { %>
                <div class="tended-table-wrap">
                    <table class="tended-activity-table" id="inquiries-data-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Age</th>
                                <th>Search Query</th>
                                <th>Safety Verdict</th>
                                <th>Caretaker Rationale</th>
                                <th>Academic / PubMed Evidence</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% queries.forEach(function(item, idx) { %>
                                <tr id="query-row-<%= idx %>">
                                    <td class="table-time-cell"><%= item.timestamp %></td>
                                    <td><span class="table-age-badge"><%= item.age %>y</span></td>
                                    <td class="table-query-cell">"<%= item.query %>"</td>
                                    <td>
                                        <span class="status-pill status-<%= item.status.toLowerCase() %>">
                                            <%= item.status === 'Allowed' ? '🌿 Safe' : (item.status === 'Risky' ? '🌾 Guidance' : '🛡️ Shielded') %>
                                        </span>
                                    </td>
                                    <td class="table-explanation-cell">
                                        <%= item.explanation %>
                                    </td>
                                    <td>
                                        <% if (item.researchCitation) { %>
                                            <div class="table-citation-pebble">
                                                <strong class="table-citation-title"><%= item.researchCitation.title %></strong>
                                                <span class="table-citation-journal"><%= item.researchCitation.journal %> (<%= item.researchCitation.year %>)</span>
                                                <a href="<%= item.researchCitation.url %>" target="_blank" rel="noopener" class="table-citation-link">
                                                    PubMed PMID: <%= item.researchCitation.pmid %> ↗
                                                </a>
                                            </div>
                                        <% } else { %>
                                            <span style="color: #929F96; font-size: 0.825rem;">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 3rem 1rem; color: #6C7A70;">
                    <p>No activity logs found for filter "<strong><%= currentFilter %></strong>".</p>
                </div>
            <% } %>

        </section>

        <!-- Caretaker Settings & Account Management Deck -->
        <section class="caretaker-settings-deck">
            
            <!-- 1. Password & Account Security -->
            <% if (user) { %>
            <div class="tended-settings-card" id="account-password-card">
                <h3>🔑 Account Password & Multi-Method Login</h3>
                <p>
                    <% if (user.passwordHash) { %>
                        Your account has a password configured. You can update it below or use Google Single Sign-On at any time.
                    <% } else { %>
                        You registered using Google. You can set a password below to enable logging in with both your Email/Password and Google.
                    <% } %>
                </p>
                
                <form method="POST" action="/account/update-password" class="tended-pin-form">
                    <div class="tended-form-grid">
                        <div class="tended-field">
                            <label for="newPassword">New Password (6+ chars):</label>
                            <input type="password" id="newPassword" name="newPassword" minlength="6" placeholder="••••••••" required class="tended-input">
                        </div>
                        <div class="tended-field">
                            <label for="confirmPassword">Confirm Password:</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" placeholder="••••••••" required class="tended-input">
                        </div>
                    </div>
                    <button type="submit" class="tended-primary-btn" id="update-password-btn">
                        <%= user.passwordHash ? 'Update Account Password' : 'Set Account Password' %>
                    </button>
                </form>
            </div>
            <% } %>

            <!-- 2. Security PIN Management -->
            <div class="tended-settings-card" id="pin-management-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                    <h3>Security PIN</h3>
                    <span class="guide-chip <%= (user && user.parentPin) ? 'chip-live' : 'chip-sandbox' %>">
                        <%= (user && user.parentPin) ? 'Active' : 'Not Configured' %>
                    </span>
                </div>

                <% if (user && user.parentPin) { %>
                    <div style="background: rgba(84, 122, 93, 0.08); border-radius: 10px; padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                        <span style="font-size: 0.9rem; color: #2d3b31;">
                            Current PIN: <strong id="current-pin-display" style="letter-spacing: 3px; font-family: monospace; font-size: 1.05rem;">••••</strong>
                        </span>
                        <button type="button" class="copy-url-btn" onclick="togglePinVisibility('<%= user.parentPin %>')" id="toggle-pin-btn">Show</button>
                    </div>
                <% } %>
                
                <form method="POST" action="/parent-change-pin" class="tended-pin-form">
                    <div class="tended-form-grid">
                        <% if (user && user.parentPin) { %>
                            <div class="tended-field">
                                <label for="currentPin">Current PIN</label>
                                <input type="password" id="currentPin" name="currentPin" placeholder="••••" required class="tended-input" autocomplete="off">
                            </div>
                        <% } %>
                        <div class="tended-field">
                            <label for="newPin"><%= (user && user.parentPin) ? 'New PIN' : 'Set PIN (4–6 digits)' %></label>
                            <input type="password" id="newPin" name="newPin" pattern="[0-9]{4,6}" inputmode="numeric" maxlength="6" minlength="4" placeholder="••••" required class="tended-input" autocomplete="off">
                        </div>
                    </div>
                    <button type="submit" class="tended-primary-btn" id="save-pin-button">
                        <%= (user && user.parentPin) ? 'Update PIN' : 'Save PIN' %>
                    </button>
                </form>
            </div>

            <!-- 3. History Archive & Reset -->
            <div class="tended-settings-card" id="data-archive-card">
                <h3>Activity History</h3>
                <p>Clear search logs and activity history.</p>
                
                <form method="POST" action="/parent-clear-logs" onsubmit="return confirm('Are you sure you wish to clear all search history logs?');">
                    <button type="submit" class="tended-danger-btn" id="clear-activity-history-btn">Clear Activity Logs</button>
                </form>
            </div>

        </section>

    </main>

    <script>
        function togglePinVisibility(actualPin) {
            const display = document.getElementById('current-pin-display');
            const btn = document.getElementById('toggle-pin-btn');
            if (!display || !btn) return;
            if (display.textContent.trim() === '••••') {
                display.textContent = actualPin;
                btn.textContent = 'Hide';
            } else {
                display.textContent = '••••';
                btn.textContent = 'Show';
            }
        }
    </script>
</body>
</html>
