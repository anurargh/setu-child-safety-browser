# Gemini API Key (Required for AI Safe Search classification)
GEMINI_API_KEY=

# Session & Cookie Encryption Secret
COOKIE_SECRET=setu-secure-random-session-secret-change-this

# App Base URL (e.g., https://your-app-name.onrender.com)
APP_URL=

# Google OAuth Credentials (for Google One-Click Registration and Login)
# Set these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
